# Public release configuration. Copy into your build environment and replace ALL placeholders.
# Vite does not load this example file automatically. Never add server secrets here.
# The application checks only non-empty values; placeholders do not make a release ready.
VITE_RELEASE_MODE=production
VITE_LEGAL_ADMIN_NAME="[PEŁNA NAZWA ADMINISTRATORA]"
VITE_LEGAL_BUSINESS_ADDRESS="[ADRES PRZEDSIĘBIORCY]"
VITE_LEGAL_REGISTRY_DETAILS="[CEIDG / KRS / NIP]"
VITE_LEGAL_CONTACT_EMAIL="privacy@example.invalid"
VITE_LEGAL_ACCOUNT_RETENTION="[FAKTYCZNA RETENCJA KONTA I DANYCH]"
VITE_LEGAL_CONSENT_RETENTION="[RETENCJA ZGÓD ZGODNA Z USUNIĘCIEM KONTA]"
VITE_LEGAL_BACKUP_RETENTION="[FAKTYCZNA RETENCJA KOPII ZAPASOWYCH]"
VITE_LEGAL_SUPABASE_REGION="[REGION WYBRANEGO PROJEKTU]"
VITE_LEGAL_SUBSCRIPTION_PRICE="[AKTUALNA CENA LUB INFORMACJA O BRAKU SPRZEDAŻY]"
VITE_LEGAL_TRIAL_DESCRIPTION="[AKTUALNE WARUNKI LUB INFORMACJA O BRAKU TRIALU]"
