    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "packageManager": "npm@11.9.0"
}
