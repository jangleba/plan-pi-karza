{
  "name": "ballwise",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:dev": "vite build --mode development",
    "ios:setup": "node scripts/setup-ios.mjs",
    "ios:sync": "node scripts/setup-ios.mjs --sync-only",
    "ios:open": "npx cap open ios",
    "preview": "wrangler --cwd .output dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "verify": "npm run typecheck && npm run test -- --testTimeout=30000 && npm run lint && npm run build",
    "verify:release": "npm run verify && npm run build:mobile",
    "cleanup:vision": "node scripts/remove-vision-lab.mjs",
    "release:check": "node scripts/release-preflight.mjs",
    "build:release": "npm run release:check && npm run build && npm run build:mobile"
  },
  "dependencies": {
    "@ballwise/camera": "file:native/ballwise-camera",
    "@ballwise/runtime": "file:native/ballwise-runtime",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@lovable.dev/mcp-js": "0.20.1",
    "@mediapipe/tasks-vision": "1.1.0",
    "@noble/hashes": "1.8.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@revenuecat/purchases-capacitor": "13.7.4",
    "@supabase/supabase-js": "2.111.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "0.575.0",
    "mp4box": "2.3.0",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "vite-tsconfig-paths": "6.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "9.39.5",
    "@lovable.dev/vite-tanstack-config": "2.26.5",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.10",
